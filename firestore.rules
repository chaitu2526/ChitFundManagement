rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email.matches('(?i)chaitu2513@gmail.com');
    }

    function isWhitelisted() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower()))
      );
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())).data.role;
    }

    function isManager() {
      return isAdmin() || (isWhitelisted() && getUserRole() == 'manager');
    }

    function isDisplayOnly() {
      return isWhitelisted() && getUserRole() == 'display';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validations
    function isValidMember(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['name', 'totalChitValue', 'totalMonths', 'startDate', 'status', 'totalSlots', 'createdAt']) &&
             data.name is string && data.name.size() > 0 &&
             data.totalChitValue is number && data.totalChitValue > 0 &&
             data.totalMonths is int && data.totalMonths > 0 &&
             data.totalSlots is int && data.totalSlots > 0 &&
             data.status in ['active', 'completed'];
    }

    function isValidGroupMember(data) {
      return data.keys().hasAll(['memberId', 'groupId', 'slots', 'joinedAt']) &&
             isValidId(data.memberId) &&
             isValidId(data.groupId) &&
             data.slots is int && data.slots > 0;
    }

    function isValidAuction(data) {
      return data.keys().hasAll(['groupId', 'monthNumber', 'winningBid', 'winnerMemberId', 'dividendPerSlot', 'auctionDate', 'createdAt']) &&
             isValidId(data.groupId) &&
             isValidId(data.winnerMemberId) &&
             data.monthNumber is int && data.monthNumber > 0 &&
             data.winningBid is number && data.winningBid >= 0 &&
             data.dividendPerSlot is number;
    }

    // Rules
    match /authorizedUsers/{email} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (isAdmin() || email.lower() == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if isWhitelisted();
      allow create: if isManager() && isValidMember(incoming()) && incoming().createdAt == request.time;
      allow update: if isManager() && isValidMember(incoming()) && 
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'phone']);
      allow delete: if isManager();
    }

    match /groups/{groupId} {
      allow read: if isWhitelisted();
      allow create: if isManager() && isValidGroup(incoming()) && incoming().createdAt == request.time;
      allow update: if isManager() && isValidGroup(incoming()) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'totalChitValue', 'totalMonths', 'totalSlots', 'startDate']);
      allow delete: if isManager();
    }

    match /groupMembers/{mappingId} {
      allow read: if isWhitelisted();
      allow create: if isManager() && isValidGroupMember(incoming()) &&
                    incoming().joinedAt == request.time &&
                    exists(/databases/$(database)/documents/members/$(incoming().memberId)) &&
                    exists(/databases/$(database)/documents/groups/$(incoming().groupId));
      allow update: if isManager() && isValidGroupMember(incoming()) &&
                    incoming().joinedAt == existing().joinedAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['slots']);
      allow delete: if isManager();
    }

    match /auctions/{auctionId} {
      allow read: if isWhitelisted();
      allow create: if isManager() && isValidAuction(incoming()) &&
                    incoming().createdAt == request.time &&
                    exists(/databases/$(database)/documents/groups/$(incoming().groupId)) &&
                    exists(/databases/$(database)/documents/members/$(incoming().winnerMemberId));
      allow update: if isManager() && isValidAuction(incoming()) &&
                    incoming().groupId == existing().groupId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['monthNumber', 'winningBid', 'winnerMemberId', 'dividendPerSlot', 'auctionDate']);
      allow delete: if isManager();
    }
  }
}
